<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <!-- JDBC Driver -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <!-- Existing V3/V4 development database -->
        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/ecommerce_db
        </property>

        <property name="hibernate.connection.username">
            root
        </property>

        <!-- Do not hardcode the password here -->

        <!-- Validate existing tables instead of creating/dropping them -->
        <property name="hibernate.hbm2ddl.auto">
            validate
        </property>

        <!-- Show generated SQL while learning Hibernate -->
        <property name="hibernate.show_sql">
            true
        </property>

        <property name="hibernate.format_sql">
            true
        </property>

        <!-- First Hibernate entity --><mapping class="com.ecommerce.model.Product"/>
        <mapping class="com.ecommerce.model.Customer"/>
        <mapping class="com.ecommerce.model.Order"/>
        <mapping class="com.ecommerce.model.OrderItem"/>
        <mapping class="com.ecommerce.model.Inventory"/>
        <mapping class="com.ecommerce.model.Payment"/>

    </session-factory>

</hibernate-configuration>